{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atai.local/schemas/analysis-task/1.0.0",
  "title": "S3 深度分析任务",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_data", "task_id", "media_task_id", "status", "progress", "current_step", "attempt_count", "max_attempts", "metric_count", "comment_count", "ocr_result_path", "result_path", "error", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "fixture_data": { "type": "boolean" },
    "task_id": { "type": "string", "pattern": "^analysis_task_[a-f0-9]{32}$" },
    "media_task_id": { "type": "string", "pattern": "^media_[a-f0-9]{32}$" },
    "model_purpose": { "enum": ["analysis", "video_review"] },
    "status": { "enum": ["pending", "running", "retry_wait", "succeeded", "completed", "failed", "cancelled"] },
    "progress": { "type": "integer", "minimum": 0, "maximum": 100 },
    "current_step": { "enum": ["queued", "ocr", "prepare", "segmenting", "segment", "gateway", "summarizing", "validate", "persist", "recovered", "cancelling", "cancelled", "completed", "failed"] },
    "attempt_count": { "type": "integer", "minimum": 0 },
    "max_attempts": { "type": "integer", "minimum": 1, "maximum": 5 },
    "metric_count": { "type": "integer", "minimum": 0 },
    "comment_count": { "type": "integer", "minimum": 0 },
    "ocr_result_path": { "type": ["string", "null"] },
    "result_path": { "type": ["string", "null"] },
    "error": { "type": ["string", "null"], "maxLength": 500 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "trace_id": { "type": "string", "pattern": "^trace_[a-f0-9]{32}$" },
    "idempotency_key": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "segment_total": { "type": "integer", "minimum": 0 },
    "segment_completed": { "type": "integer", "minimum": 0 },
    "current_segment": { "type": ["integer", "null"], "minimum": 0 },
    "last_completed_segment": { "type": ["integer", "null"], "minimum": 0 },
    "last_checkpoint_at": { "type": ["string", "null"], "format": "date-time" },
    "next_retry_at": { "type": ["string", "null"], "format": "date-time" },
    "recovering": { "type": "boolean" },
    "cancel_requested": { "type": "boolean" },
    "diagnostic_code": { "type": ["string", "null"], "maxLength": 120 },
    "retry_count": { "type": "integer", "minimum": 0 }
  }
}
