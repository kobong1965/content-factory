{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atai.local/schemas/shooting-task/1.0.0",
  "title": "爆款内容工厂拍摄任务",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_data", "task_id", "script_id", "script_revision", "product_id", "status", "requirements", "missing_count", "matched_count", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "fixture_data": { "type": "boolean" },
    "task_id": { "$ref": "#/$defs/id" },
    "script_id": { "$ref": "#/$defs/id" },
    "script_revision": { "type": "integer", "minimum": 1 },
    "selected_version_id": { "$ref": "#/$defs/id" },
    "product_id": { "$ref": "#/$defs/id" },
    "status": { "enum": ["pending_shoot", "materials_uploaded", "ready_for_edit"] },
    "requirements": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/requirement" } },
    "missing_count": { "type": "integer", "minimum": 0 },
    "matched_count": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$" },
    "nonEmptyText": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_id", "clip_id", "score", "repeat_risk", "reason"],
      "properties": {
        "material_id": { "$ref": "#/$defs/id" },
        "clip_id": { "$ref": "#/$defs/id" },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "repeat_risk": { "enum": ["low", "medium", "high"] },
        "reason": { "$ref": "#/$defs/nonEmptyText" },
        "continuous_take_reusable": { "type": "boolean" }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script_shot_id", "version_id", "order", "requirement_status", "purpose", "visual", "voiceover", "match_status", "suggestions", "confirmed_match"],
      "properties": {
        "script_shot_id": { "$ref": "#/$defs/id" },
        "requirement_kind": { "enum": ["primary", "detail_overlay"] },
        "source_script_shot_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "detail_tag": { "anyOf": [{ "$ref": "#/$defs/nonEmptyText" }, { "type": "null" }] },
        "version_id": { "$ref": "#/$defs/id" },
        "order": { "type": "integer", "minimum": 1 },
        "requirement_status": { "enum": ["required", "reusable", "reshoot", "optional"] },
        "purpose": { "enum": ["hook", "proof", "detail", "comfort", "cta", "transition", "broll"] },
        "visual": { "$ref": "#/$defs/nonEmptyText" },
        "voiceover": { "$ref": "#/$defs/nonEmptyText" },
        "match_status": { "enum": ["missing", "suggested", "confirmed", "optional"] },
        "suggestions": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/suggestion" } },
        "confirmed_match": { "anyOf": [{ "$ref": "#/$defs/suggestion" }, { "type": "null" }] }
      }
    }
  }
}
