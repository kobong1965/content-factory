{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atai.local/schemas/viral-skill/1.0.0",
  "title": "爆款内容工厂正式爆点 Skill",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_id",
    "origin_candidate_id",
    "based_on_candidate_revision",
    "revision",
    "status",
    "reuse_mode",
    "name",
    "mechanism",
    "classification",
    "evidence_level",
    "causality_status",
    "distinct_video_count",
    "occurrence_count",
    "representative_occurrence_id",
    "steps",
    "necessary_conditions",
    "failure_signals",
    "occurrences",
    "review",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "skill_id": { "type": "string", "pattern": "^skill_[a-f0-9]{32}$" },
    "origin_candidate_id": { "type": "string", "pattern": "^candidate_[a-f0-9]{32}$" },
    "based_on_candidate_revision": { "type": "integer", "minimum": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["approved", "disabled"] },
    "reuse_mode": { "enum": ["reuse", "avoid"] },
    "name": { "$ref": "#/$defs/nonEmptyText" },
    "mechanism": { "$ref": "#/$defs/nonEmptyText" },
    "classification": { "enum": ["single_video", "common_candidate"] },
    "evidence_level": { "enum": ["content_observation", "content_inference", "metric_correlation"] },
    "causality_status": { "const": "not_established" },
    "distinct_video_count": { "type": "integer", "minimum": 1 },
    "occurrence_count": { "type": "integer", "minimum": 1 },
    "representative_occurrence_id": { "type": "string", "pattern": "^occurrence_[a-f0-9]{32}$" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/canonicalStep" }
    },
    "necessary_conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyText" },
      "uniqueItems": true
    },
    "failure_signals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyText" },
      "uniqueItems": true
    },
    "occurrences": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/occurrence" }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "reviewed_at", "note"],
      "properties": {
        "reviewer": { "$ref": "#/$defs/nonEmptyText" },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "note": { "type": ["string", "null"] }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$" },
    "nonEmptyText": { "type": "string", "minLength": 1 },
    "nullableText": { "type": ["string", "null"] },
    "nullableTime": { "type": ["integer", "null"], "minimum": 0 },
    "canonicalStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "description"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "description": { "$ref": "#/$defs/nonEmptyText" }
      }
    },
    "evidenceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "qualified_evidence_id",
        "claim",
        "source_type",
        "source_id",
        "start_ms",
        "end_ms",
        "confidence",
        "is_inference",
        "exact_dialogue",
        "subtitle",
        "action",
        "visual_event",
        "metric_values",
        "comment_text"
      ],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/id" },
        "qualified_evidence_id": { "type": "string", "minLength": 5 },
        "claim": { "$ref": "#/$defs/nonEmptyText" },
        "source_type": { "enum": ["shot", "timeline", "metric", "comment", "transcript", "keyframe"] },
        "source_id": { "$ref": "#/$defs/id" },
        "start_ms": { "$ref": "#/$defs/nullableTime" },
        "end_ms": { "$ref": "#/$defs/nullableTime" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "is_inference": { "type": "boolean" },
        "exact_dialogue": { "$ref": "#/$defs/nullableText" },
        "subtitle": { "$ref": "#/$defs/nullableText" },
        "action": { "$ref": "#/$defs/nullableText" },
        "visual_event": { "$ref": "#/$defs/nullableText" },
        "metric_values": {
          "type": ["object", "null"],
          "additionalProperties": { "type": ["number", "null"] }
        },
        "comment_text": { "$ref": "#/$defs/nullableText" }
      }
    },
    "occurrenceStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "description", "evidence"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "description": { "$ref": "#/$defs/nonEmptyText" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceSnapshot" }
        }
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrence_id",
        "analysis_task_id",
        "media_task_id",
        "analysis_id",
        "analysis_revision",
        "report_sha256",
        "video_id",
        "source_id",
        "source_type",
        "source_name",
        "pattern_id",
        "pattern_name",
        "pattern_mechanism",
        "accepted_by",
        "accepted_at",
        "start_ms",
        "end_ms",
        "has_primary_evidence",
        "steps"
      ],
      "properties": {
        "occurrence_id": { "type": "string", "pattern": "^occurrence_[a-f0-9]{32}$" },
        "analysis_task_id": { "type": "string", "pattern": "^analysis_task_[a-f0-9]{32}$" },
        "media_task_id": { "type": "string", "pattern": "^media_[a-f0-9]{32}$" },
        "analysis_id": { "$ref": "#/$defs/id" },
        "analysis_revision": { "type": "integer", "minimum": 1 },
        "report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "video_id": { "$ref": "#/$defs/id" },
        "source_id": { "$ref": "#/$defs/id" },
        "source_type": { "enum": ["douyin_link", "local_file", "authorized_api"] },
        "source_name": { "$ref": "#/$defs/nonEmptyText" },
        "pattern_id": { "$ref": "#/$defs/id" },
        "pattern_name": { "$ref": "#/$defs/nonEmptyText" },
        "pattern_mechanism": { "$ref": "#/$defs/nonEmptyText" },
        "accepted_by": { "$ref": "#/$defs/nonEmptyText" },
        "accepted_at": { "type": "string", "format": "date-time" },
        "start_ms": { "$ref": "#/$defs/nullableTime" },
        "end_ms": { "$ref": "#/$defs/nullableTime" },
        "has_primary_evidence": { "type": "boolean" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/occurrenceStep" }
        }
      }
    }
  }
}
