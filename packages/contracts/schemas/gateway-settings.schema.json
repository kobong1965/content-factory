{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atai.local/schemas/gateway-settings/2.1.0",
  "title": "S3 多提供方多模态模型设置",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "base_url",
    "model",
    "api_mode",
    "api_key_configured",
    "default_model_id",
    "models",
    "routing",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "enum": ["2.0.0", "2.1.0"] },
    "base_url": { "type": "string", "maxLength": 2048 },
    "model": { "type": "string", "maxLength": 120 },
    "api_mode": { "enum": ["responses", "chat_completions"] },
    "api_key_configured": { "type": "boolean" },
    "default_model_id": {
      "anyOf": [
        { "$ref": "#/$defs/modelId" },
        { "type": "null" }
      ]
    },
    "models": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/model" }
    },
    "routing": { "$ref": "#/$defs/routing" },
    "updated_at": {
      "anyOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": "2.1.0" } },
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "models": {
            "items": { "required": ["provider"] }
          },
          "routing": { "required": ["video_review"] }
        }
      }
    }
  ],
  "$defs": {
    "modelId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "display_name",
        "base_url",
        "model",
        "api_mode",
        "modalities",
        "purposes",
        "enabled",
        "api_key_configured"
      ],
      "properties": {
        "model_id": { "$ref": "#/$defs/modelId" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "provider": { "enum": ["openai", "qwen", "openai_compatible", "custom"] },
        "base_url": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "model": { "type": "string", "minLength": 1, "maxLength": 120 },
        "api_mode": { "enum": ["responses", "chat_completions"] },
        "modalities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["text", "image"] }
        },
        "purposes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["analysis", "script", "material", "video_review"] }
        },
        "enabled": { "type": "boolean" },
        "api_key_configured": { "type": "boolean" }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis", "script", "material"],
      "properties": {
        "analysis": {
          "anyOf": [{ "$ref": "#/$defs/modelId" }, { "type": "null" }]
        },
        "script": {
          "anyOf": [{ "$ref": "#/$defs/modelId" }, { "type": "null" }]
        },
        "material": {
          "anyOf": [{ "$ref": "#/$defs/modelId" }, { "type": "null" }]
        },
        "video_review": {
          "anyOf": [{ "$ref": "#/$defs/modelId" }, { "type": "null" }]
        }
      }
    }
  }
}
