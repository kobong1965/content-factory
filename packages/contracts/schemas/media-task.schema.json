{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atai.local/schemas/media-task/1.0.0",
  "title": "S2 本地媒体任务",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "fixture_data", "task_id", "status", "progress", "current_step",
    "source_name", "source_path", "workspace_path", "attempt_count", "max_attempts",
    "error", "result_path", "created_at", "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "fixture_data": { "type": "boolean" },
    "task_id": { "type": "string", "pattern": "^media_[a-f0-9]{32}$" },
    "status": { "enum": ["pending", "running", "retry_wait", "completed", "failed"] },
    "progress": { "type": "integer", "minimum": 0, "maximum": 100 },
    "current_step": {
      "enum": ["queued", "probe", "copy", "proxy", "audio", "asr", "scenes", "keyframes", "finalize", "recovered", "completed", "failed"]
    },
    "source_name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "source_path": { "type": "string", "minLength": 1 },
    "workspace_path": { "type": "string", "minLength": 1 },
    "attempt_count": { "type": "integer", "minimum": 0 },
    "max_attempts": { "type": "integer", "minimum": 1, "maximum": 5 },
    "error": { "type": ["string", "null"] },
    "result_path": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
