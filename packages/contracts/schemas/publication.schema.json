{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-factory.local/schemas/publication.schema.json",
  "title": "S8 Douyin publication",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_data", "revision", "publication_id", "platform", "output_id", "project_id", "project_revision", "variant_id", "script_id", "script_version_id", "product_id", "status", "work_url", "work_id", "account_label", "title", "published_at", "registered_by", "note", "output_sha256", "business_review", "history", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "fixture_data": {"type": "boolean"},
    "revision": {"type": "integer", "minimum": 1},
    "publication_id": {"type": "string", "pattern": "^publication_[A-Za-z0-9_-]{6,80}$"},
    "platform": {"const": "douyin_cn"},
    "output_id": {"type": "string", "minLength": 6, "maxLength": 120},
    "project_id": {"type": "string", "minLength": 6, "maxLength": 120},
    "project_revision": {"type": "integer", "minimum": 1},
    "variant_id": {"type": "string", "minLength": 6, "maxLength": 120},
    "script_id": {"type": "string", "minLength": 6, "maxLength": 120},
    "script_version_id": {"type": "string", "minLength": 6, "maxLength": 120},
    "product_id": {"type": "string", "minLength": 6, "maxLength": 120},
    "status": {"enum": ["published", "archived"]},
    "work_url": {"type": "string", "format": "uri", "maxLength": 500},
    "work_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{6,40}$"},
    "account_label": {"type": "string", "minLength": 1, "maxLength": 100},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "published_at": {"type": "string", "format": "date-time"},
    "registered_by": {"type": "string", "minLength": 1, "maxLength": 100},
    "note": {"type": "string", "maxLength": 1000},
    "output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "business_review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reviewed_by", "reviewed_at", "note"],
      "properties": {
        "status": {"enum": ["pending", "confirmed"]},
        "reviewed_by": {"type": ["string", "null"], "maxLength": 100},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "note": {"type": "string", "maxLength": 1000}
      }
    },
    "history": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["revision", "action", "actor", "at", "note"],
        "properties": {
          "revision": {"type": "integer", "minimum": 1},
          "action": {"enum": ["registered", "corrected", "archived", "restored", "loop_confirmed"]},
          "actor": {"type": "string", "minLength": 1, "maxLength": 100},
          "at": {"type": "string", "format": "date-time"},
          "note": {"type": "string", "maxLength": 1000}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
