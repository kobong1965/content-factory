{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atai.local/schemas/ocr-result/1.0.0",
  "title": "S3 本地关键帧 OCR 结果",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_data", "ocr_id", "media_task_id", "status", "engine", "frames", "timings_ms", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "fixture_data": { "type": "boolean" },
    "ocr_id": { "type": "string", "pattern": "^ocr_[a-f0-9]{32}$" },
    "media_task_id": { "type": "string", "pattern": "^media_[a-f0-9]{32}$" },
    "status": { "const": "completed" },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "rapidocr" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shot_id", "keyframe_id", "keyframe_path", "lines"],
        "properties": {
          "shot_id": { "type": "string", "pattern": "^shot_[0-9]{3}$" },
          "keyframe_id": { "type": "string", "pattern": "^frame_[a-z0-9_-]{3,63}$" },
          "keyframe_path": { "type": "string", "minLength": 1 },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text", "confidence", "bbox"],
              "properties": {
                "id": { "type": "string", "pattern": "^ocr_line_[a-z0-9_-]{3,63}$" },
                "text": { "type": "string", "minLength": 1 },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "bbox": {
                  "type": "array",
                  "prefixItems": [
                    { "type": "number", "minimum": 0 },
                    { "type": "number", "minimum": 0 },
                    { "type": "number", "minimum": 0 },
                    { "type": "number", "minimum": 0 }
                  ],
                  "minItems": 4,
                  "maxItems": 4
                }
              }
            }
          }
        }
      }
    },
    "timings_ms": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 },
      "minProperties": 1
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
