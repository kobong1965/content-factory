{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atai.local/schemas/media-result/1.0.0",
  "title": "S2 本地媒体处理结果",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "fixture_data", "task_id", "source", "media", "artifacts",
    "asr", "shots", "timings_ms", "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "fixture_data": { "type": "boolean" },
    "task_id": { "type": "string", "pattern": "^media_[a-f0-9]{32}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_name", "sha256", "size_bytes", "managed_original_path"],
      "properties": {
        "original_name": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "managed_original_path": { "type": "string", "minLength": 1 }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms", "width", "height", "fps", "video_codec", "audio_codec", "has_audio", "format_name"],
      "properties": {
        "duration_ms": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "video_codec": { "type": "string", "minLength": 1 },
        "audio_codec": { "type": ["string", "null"] },
        "has_audio": { "type": "boolean" },
        "format_name": { "type": "string", "minLength": 1 }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proxy_path", "audio_path", "transcript_path", "scene_manifest_path"],
      "properties": {
        "proxy_path": { "type": "string", "minLength": 1 },
        "audio_path": { "type": ["string", "null"] },
        "transcript_path": { "type": ["string", "null"] },
        "scene_manifest_path": { "type": "string", "minLength": 1 }
      }
    },
    "asr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "model_name", "language", "segment_count"],
      "properties": {
        "status": { "enum": ["completed", "no_audio", "model_missing"] },
        "model_name": { "type": ["string", "null"] },
        "language": { "type": ["string", "null"] },
        "segment_count": { "type": "integer", "minimum": 0 }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start_ms", "end_ms", "scene_score", "keyframe_path"],
        "properties": {
          "id": { "type": "string", "pattern": "^shot_[0-9]{3}$" },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 1 },
          "scene_score": { "type": "number", "minimum": 0, "maximum": 100 },
          "keyframe_path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "timings_ms": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
