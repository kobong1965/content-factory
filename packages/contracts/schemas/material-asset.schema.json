{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atai.local/schemas/material-asset/1.0.0",
  "title": "爆款内容工厂素材档案",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_data", "revision", "material_id", "product_id", "product_revision", "source_script_id", "file", "archive", "processing", "clips", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "fixture_data": { "type": "boolean" },
    "revision": { "type": "integer", "minimum": 1 },
    "material_id": { "$ref": "#/$defs/id" },
    "product_id": { "$ref": "#/$defs/id" },
    "product_revision": { "type": "integer", "minimum": 1 },
    "source_script_id": { "type": ["string", "null"] },
    "capture_role": { "enum": ["host_take", "detail", "standard"] },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_name", "mime_type", "sha256", "size_bytes", "duration_ms", "width", "height", "fps", "has_audio", "original_ref", "proxy_ref"],
      "properties": {
        "original_name": { "$ref": "#/$defs/nonEmptyText" },
        "mime_type": { "enum": ["video/mp4", "video/quicktime", "video/x-matroska", "video/x-msvideo", "video/webm", "video/x-m4v"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "duration_ms": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "has_audio": { "type": "boolean" },
        "original_ref": { "$ref": "#/$defs/id" },
        "proxy_ref": { "$ref": "#/$defs/id" }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_name", "scene", "shot_date", "batch", "imported_by", "note"],
      "properties": {
        "model_name": { "$ref": "#/$defs/nonEmptyText" },
        "scene": { "$ref": "#/$defs/nonEmptyText" },
        "shot_date": { "type": "string", "format": "date" },
        "batch": { "$ref": "#/$defs/nonEmptyText" },
        "imported_by": { "$ref": "#/$defs/nonEmptyText" },
        "note": { "type": "string", "maxLength": 2000 }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_task_id", "local_status", "asr_status", "recognition_status", "provider", "model", "recognized_at", "original_video_uploaded"],
      "properties": {
        "media_task_id": { "$ref": "#/$defs/id" },
        "local_status": { "const": "completed" },
        "asr_status": { "enum": ["completed", "no_audio", "model_missing"] },
        "recognition_status": { "enum": ["pending", "completed", "not_configured", "failed"] },
        "provider": { "type": ["string", "null"] },
        "model_profile_id": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_-]{2,63}$" },
        "model": { "type": ["string", "null"] },
        "recognized_at": { "type": ["string", "null"], "format": "date-time" },
        "original_video_uploaded": { "const": false }
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/clip" }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$" },
    "nonEmptyText": { "type": "string", "minLength": 1, "maxLength": 500 },
    "tag": { "type": "string", "minLength": 1, "maxLength": 80 },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_shot_id", "order", "start_ms", "end_ms", "keyframe_ref", "transcript", "purpose_tags", "visual_tags", "garment_views", "action_tags", "scene_tags", "shot_size", "people_count", "standalone_usable", "reusable", "quality", "note"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source_shot_id": { "$ref": "#/$defs/id" },
        "order": { "type": "integer", "minimum": 1 },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 },
        "keyframe_ref": { "$ref": "#/$defs/id" },
        "transcript": { "type": "string", "maxLength": 5000 },
        "purpose_tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["hook", "proof", "detail", "comfort", "cta", "transition", "broll"] } },
        "visual_tags": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "$ref": "#/$defs/tag" } },
        "garment_views": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "enum": ["front", "side", "back", "detail", "full_body", "unknown"] } },
        "action_tags": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/tag" } },
        "scene_tags": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/tag" } },
        "shot_size": { "type": "string", "maxLength": 100 },
        "people_count": { "type": "integer", "minimum": 0, "maximum": 20 },
        "standalone_usable": { "type": "boolean" },
        "reusable": { "type": "boolean" },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clarity", "stability", "audio", "exposure", "overall"],
          "properties": {
            "clarity": { "$ref": "#/$defs/score" },
            "stability": { "$ref": "#/$defs/score" },
            "audio": { "$ref": "#/$defs/score" },
            "exposure": { "$ref": "#/$defs/score" },
            "overall": { "$ref": "#/$defs/score" }
          }
        },
        "note": { "type": "string", "maxLength": 2000 },
        "capture_scope": { "enum": ["scene", "full_take"] }
      }
    }
  }
}
