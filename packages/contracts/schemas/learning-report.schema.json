{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-factory.local/schemas/learning-report.schema.json",
  "title": "S8 explainable learning report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_data", "report_id", "product_id", "status", "primary_metric", "target_window_minutes", "publication_ids", "comparison", "winner_publication_id", "observations", "evidence", "limitations", "next_tests", "generated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "fixture_data": {"type": "boolean"},
    "report_id": {"type": "string", "pattern": "^learning_report_[A-Za-z0-9_-]{6,80}$"},
    "product_id": {"type": "string", "minLength": 6, "maxLength": 120},
    "status": {"enum": ["ready", "insufficient_data"]},
    "primary_metric": {"enum": ["views", "retention_3s", "completion_rate", "engagement_per_1000", "product_ctr", "conversion_rate", "orders", "gmv_cents"]},
    "target_window_minutes": {"type": "integer", "minimum": 1},
    "publication_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "comparison": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["publication_id", "snapshot_id", "variant_id", "observation_minutes", "value", "views", "engagement_per_1000"],
        "properties": {
          "publication_id": {"type": "string"},
          "snapshot_id": {"type": "string"},
          "variant_id": {"type": "string"},
          "observation_minutes": {"type": "integer", "minimum": 0},
          "value": {"type": ["number", "null"], "minimum": 0},
          "views": {"type": ["integer", "null"], "minimum": 0},
          "engagement_per_1000": {"type": ["number", "null"], "minimum": 0}
        }
      }
    },
    "winner_publication_id": {"type": ["string", "null"]},
    "observations": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["publication_id", "snapshot_id", "statement"],
        "properties": {
          "publication_id": {"type": "string"},
          "snapshot_id": {"type": "string"},
          "statement": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "next_tests": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
